# Demo Environment Configuration
# Use this for local demos without AWS dependencies

# Demo Mode
VITE_DEMO_MODE=true
VITE_USE_MOCK_API=true

# Fake API URLs (won't be used in demo mode)
VITE_API_BASE_URL=http://localhost:3000/demo
VITE_BEATS_API_BASE_URL=http://localhost:3001/demo

# Demo AWS Configuration (fake values for demo)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=demo-pool-id
VITE_COGNITO_USER_POOL_CLIENT_ID=demo-client-id
VITE_S3_BUCKET_NAME=demo-bucket

# Development Configuration
VITE_DEV_MODE=true
VITE_SHOW_DEMO_BANNER=true