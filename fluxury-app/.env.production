# Production Environment Configuration
# ⚠️ UPDATE THESE VALUES AFTER AWS DEPLOYMENT

# Production Mode
VITE_DEMO_MODE=false
VITE_USE_MOCK_API=false

# API URLs (UPDATE after CDK deployment)
VITE_API_BASE_URL=https://api.fluxury.com
VITE_BEATS_API_BASE_URL=https://api.fluxury.com/beats

# AWS Configuration (UPDATE with real values from CDK output)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=REPLACE_WITH_REAL_POOL_ID
VITE_COGNITO_USER_POOL_CLIENT_ID=REPLACE_WITH_REAL_CLIENT_ID
VITE_S3_BUCKET_NAME=REPLACE_WITH_REAL_BUCKET_NAME

# Production Configuration
VITE_DEV_MODE=false
VITE_SHOW_DEMO_BANNER=false

# Analytics (add when ready)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Feature flags
VITE_ENABLE_COLLABORATION=true
VITE_ENABLE_PAYMENTS=false