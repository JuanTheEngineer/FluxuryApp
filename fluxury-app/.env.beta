# FluxuryApp Beta Environment Configuration
# This file will be auto-updated by the deployment script

# Beta Mode
VITE_DEMO_MODE=false
VITE_USE_MOCK_API=false
VITE_ENVIRONMENT=beta

# API URLs (auto-updated by deployment script)
VITE_API_BASE_URL=https://your-api-gateway-url.amazonaws.com/beta
VITE_BEATS_API_BASE_URL=https://your-api-gateway-url.amazonaws.com/beta

# AWS Configuration (auto-updated by deployment script)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_USER_POOL_CLIENT_ID=your-client-id
VITE_S3_BUCKET_NAME=your-bucket-name

# Beta Features
VITE_BETA_MODE=true
VITE_SHOW_BETA_BANNER=true
VITE_ENABLE_FEEDBACK=true
VITE_MAX_SESSIONS=50

# Domain Configuration
VITE_DOMAIN_ROOT=juantheengineer.com
VITE_APP_PATH=/fluxury

# Feature flags for beta
VITE_ENABLE_COLLABORATION=true
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_ANALYTICS=false
VITE_MAX_FILE_SIZE=10485760

# Beta feedback
VITE_FEEDBACK_EMAIL=juan@juantheengineer.com
VITE_SUPPORT_CHAT=false