{
  "name": "fluxury-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "fluxury-app",
    "fluxury-infra",
    "fluxury-server"
  ],
  "scripts": {
    "dev:app": "cd fluxury-app && npm run dev",
    "dev:server": "cd fluxury-server && npm start",
    "build:app": "cd fluxury-app && npm run build",
    "deploy:infra": "cd fluxury-infra && cdk deploy",
    "install:all": "npm install && cd fluxury-app && npm install && cd ../fluxury-infra && npm install && cd ../fluxury-server && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
