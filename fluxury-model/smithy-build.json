{
  "version": "1.0",
  "sources": ["models"],
  "maven": {
    "dependencies": [
      "software.amazon.smithy:smithy-openapi:1.50.0",
      "software.amazon.smithy:smithy-aws-traits:1.50.0"
    ]
  },
  "projections": {
    "openapi-sessions": {
      "plugins": {
        "openapi": {
          "service": "com.fluxury.sessions#FluxurySessionService",
          "protocol": "aws.protocols#restJson1",
          "version": "3.1.0"
        }
      }
    },
    "openapi-beats": {
      "plugins": {
        "openapi": {
          "service": "com.fluxury.beats#FluxuryBeatService",
          "protocol": "aws.protocols#restJson1",
          "version": "3.1.0"
        }
      }
    }
  }
}